rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Study spot locations — publicly readable, publicly writable for now.
    // TODO: Restrict writes to authenticated users once auth flow is implemented.
    match /spots/{spotId} {
      allow read: if true;
      allow update: if true;
    }

    // Check-in records — publicly readable, create-only for crowd-level reports.
    // TODO: Restrict creates to authenticated users once auth flow is implemented.
    match /checkins/{checkinId} {
      allow read: if true;
      allow create: if true;
    }

    // Deny all other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
